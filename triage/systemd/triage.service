[Unit]
Description=Linear triage webhook → PM agent → Linear comment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/work/triage
EnvironmentFile=/etc/triage/env
ExecStart=/root/work/triage/.venv/bin/uvicorn triage_service:app --host 127.0.0.1 --port 8088 --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/triage.log
StandardError=append:/var/log/triage.log

[Install]
WantedBy=multi-user.target
